APP_NAME="Remote Arena"
APP_ENV=local
APP_KEY=base64:DCdbeHw6mPbFDx7Y2D8bos/v/spM7JvdIhWxMmliuEw=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=connection
DB_USERNAME=root
DB_PASSWORD=07775000

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
# `jobs` is the job-postings table in this schema, so the queue uses its own.
DB_QUEUE_TABLE=queue_jobs

CACHE_STORE=database
CACHE_DATABASE_TABLE=cache
CACHE_DATABASE_CONNECTION=null

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@remotearena.io"
MAIL_FROM_NAME="${APP_NAME}"

# Production: use ses, mailgun, postmark, etc.
# MAIL_MAILER=ses
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# Verification (employer + candidate trust)
# Domain verification works with no credentials. The rest stay disabled until
# their provider is configured, and report 503 rather than failing applicants.
VERIFY_REQUIRE_FOR_POSTING=false      # gate job posting on a verified company
VERIFY_DOMAIN_TTL_DAYS=365
VERIFY_IDENTITY_TTL_DAYS=730
VERIFY_GITHUB_MIN_AGE_DAYS=180
VERIFY_GITHUB_MIN_REPOS=3

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
OPENCORPORATES_API_KEY=

# Stripe (for subscription payments)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# CORS (set to your frontend URL)
FRONTEND_URL=http://localhost:5173

SANCTUM_STATEFUL_DOMAINS=localhost:5173
